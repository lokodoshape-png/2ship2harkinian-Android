     // TODO discard if alpha is 0?
     if (cc_features.opt_fog) {
+        // Cel shading only touches fogged draws, which is the 3D world; the HUD and 2D images stay untouched.
+        append_line(fs_buf, &fs_len, "if (color_cel_bands > 0.5) {");
+        append_line(fs_buf, &fs_len, "    float celLuma = max(dot(texel.rgb, vec3(0.299, 0.587, 0.114)), 0.001);");
+        append_line(fs_buf, &fs_len,
+                    "    float celBand = (floor(celLuma * color_cel_bands) + 0.5) / color_cel_bands;");
+        append_line(fs_buf, &fs_len, "    texel.rgb = clamp(texel.rgb * (celBand / celLuma), 0.0, 1.0);");
+        append_line(fs_buf, &fs_len, "}");
         if (cc_features.opt_alpha) {
             append_line(fs_buf, &fs_len, "texel = vec4(mix(texel.rgb, vFog.rgb, vFog.a), texel.a);");
         } else {
