+    D3D11_VIEWPORT prev_viewport;
+    D3D11_RECT prev_scissor;
+    d3d.context->RSGetViewports(&num_viewports, &prev_viewport);
+    d3d.context->RSGetScissorRects(&num_scissors, &prev_scissor);
+
+    // The depth buffer is read as a texture, so it can't stay bound for writing during the pass.
+    d3d.context->OMSetRenderTargets(1, fb.render_target_view.GetAddressOf(), nullptr);
+    D3D11_VIEWPORT viewport = { 0.0f, 0.0f, (float)tex.width, (float)tex.height, 0.0f, 1.0f };
+    D3D11_RECT scissor = { 0, 0, (LONG)tex.width, (LONG)tex.height };
+    d3d.context->RSSetViewports(1, &viewport);
+    d3d.context->RSSetScissorRects(1, &scissor);
+
+    d3d.context->IASetInputLayout(nullptr);
+    d3d.context->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    d3d.context->VSSetShader(d3d.outline_vs.Get(), nullptr, 0);
+    d3d.context->PSSetShader(d3d.outline_ps.Get(), nullptr, 0);
+    d3d.context->PSSetConstantBuffers(2, 1, d3d.outline_cb.GetAddressOf());
+    ID3D11ShaderResourceView* srvs[2] = { fb.depth_stencil_srv.Get(), fb.stencil_srv.Get() };
+    d3d.context->PSSetShaderResources(0, 2, srvs);
+    d3d.context->OMSetBlendState(d3d.outline_blend_state.Get(), nullptr, 0xFFFFFFFF);
+    d3d.context->Draw(3, 0);
