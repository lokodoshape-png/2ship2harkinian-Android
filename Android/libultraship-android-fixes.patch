+bool gfx_opengl_outlines_wanted(void) {
+    return CVarGetInteger("gEnhancements.Graphics.CelShading", 0) &&
+           CVarGetInteger("gEnhancements.Graphics.CelOutline", 1);
+}
+
+static GLuint gfx_opengl_compile_outline_shader(GLenum type, const char* src) {
+    GLuint shader = glCreateShader(type);
+    glShaderSource(shader, 1, &src, NULL);
+    glCompileShader(shader);
+    GLint success;
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &success);
+    if (!success) {
+        char log[1024];
+        glGetShaderInfoLog(shader, sizeof(log), NULL, log);
+        fprintf(stderr, "Outline shader compilation failed: %s\n", log);
+        glDeleteShader(shader);
+        return 0;
+    }
+    return shader;
+}
+
+static bool gfx_opengl_init_outline_program(void) {
+#if defined(__APPLE__)
+#define OUTLINE_GLSL_HEADER "#version 410 core\n"
+#elif defined(USE_OPENGLES)
+#define OUTLINE_GLSL_HEADER "#version 300 es\nprecision highp float;\n"
+#else
+#define OUTLINE_GLSL_HEADER "#version 130\n"
+#endif
+    static const char* vs_src = OUTLINE_GLSL_HEADER
+        "out vec2 uv;\n"
+        "void main() {\n"
+        "    vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));\n"
+        "    uv = p;\n"
+        "    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);\n"
+        "}\n";
+    // Depth is stored as 1 - d, which is proportional to 1/z, so flat surfaces vary linearly across the screen.
+    // A pixel whose neighbour on either side is clearly farther (a dip in the second difference) sits on the near
+    // side of a silhouette and gets painted black. Floors seen at a low angle stay clean because they are flat.
+    static const char* fs_src = OUTLINE_GLSL_HEADER
+        "in vec2 uv;\n"
+        "out vec4 fragColor;\n"
+        "uniform sampler2D uDepth;\n"
+        "uniform vec2 uStep;\n"
+        "float w(vec2 o) { return 1.0 - texture(uDepth, uv + o).r; }\n"
+        "void main() {\n"
+        "    float c = w(vec2(0.0));\n"
+        "    if (c <= 0.0) discard;\n"
+        "    float l = w(vec2(-uStep.x, 0.0));\n"
+        "    float r = w(vec2(uStep.x, 0.0));\n"
+        "    float d = w(vec2(0.0, -uStep.y));\n"
+        "    float u = w(vec2(0.0, uStep.y));\n"
+        "    float dip = max(2.0 * c - l - r, 2.0 * c - d - u) / c;\n"
+        "    float edge = smoothstep(0.03, 0.09, dip);\n"
+        "    if (edge <= 0.0) discard;\n"
+        "    fragColor = vec4(0.0, 0.0, 0.0, edge * 0.9);\n"
+        "}\n";
+#undef OUTLINE_GLSL_HEADER
+
+    GLuint vs = gfx_opengl_compile_outline_shader(GL_VERTEX_SHADER, vs_src);
+    GLuint fs = gfx_opengl_compile_outline_shader(GL_FRAGMENT_SHADER, fs_src);
+    if (vs == 0 || fs == 0) {
+        return false;
+    }
+    outline_program = glCreateProgram();
+    glAttachShader(outline_program, vs);
+    glAttachShader(outline_program, fs);
+    glLinkProgram(outline_program);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    GLint linked;
+    glGetProgramiv(outline_program, GL_LINK_STATUS, &linked);
+    if (!linked) {
+        fprintf(stderr, "Outline shader link failed\n");
+        glDeleteProgram(outline_program);
+        outline_program = 0;
+        return false;
+    }
+    outline_depth_location = glGetUniformLocation(outline_program, "uDepth");
+    outline_step_location = glGetUniformLocation(outline_program, "uStep");
+    glGenFramebuffers(1, &outline_fbo);
+    glGenTextures(1, &outline_depth_tex);
+    return true;
+}
+
+// Draws the cel shading outlines over a finished game frame. Runs only on a single-sample framebuffer the game
+// rendered into, and puts back every bit of GL state it touches.
+void gfx_opengl_draw_outlines(int fb_id) {
+    static bool init_failed = false;
+    if (!outline_enabled || init_failed || fb_id <= 0 || (size_t)fb_id >= framebuffers.size()) {
+        return;
+    }
+    Framebuffer& fb = framebuffers[fb_id];
+    if (fb.msaa_level > 1 || !fb.has_depth_buffer) {
+        return;
+    }
+    if (outline_program == 0 && !gfx_opengl_init_outline_program()) {
+        init_failed = true;
+        return;
+    }
+
+    GLint prev_program, prev_active_texture, prev_viewport[4];
+    glGetIntegerv(GL_CURRENT_PROGRAM, &prev_program);
+    glGetIntegerv(GL_ACTIVE_TEXTURE, &prev_active_texture);
+    glGetIntegerv(GL_VIEWPORT, prev_viewport);
+    GLboolean prev_blend = glIsEnabled(GL_BLEND);
+    GLboolean prev_depth_test = glIsEnabled(GL_DEPTH_TEST);
+    GLboolean prev_scissor = glIsEnabled(GL_SCISSOR_TEST);
+    GLboolean prev_depth_mask;
+    glGetBooleanv(GL_DEPTH_WRITEMASK, &prev_depth_mask);
+
+    glActiveTexture(GL_TEXTURE0 + 7);
+    glBindTexture(GL_TEXTURE_2D, outline_depth_tex);
+    if (outline_width != fb.width || outline_height != fb.height) {
+        outline_width = fb.width;
+        outline_height = fb.height;
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH24_STENCIL8, fb.width, fb.height, 0, GL_DEPTH_STENCIL,
+                     GL_UNSIGNED_INT_24_8, NULL);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glBindFramebuffer(GL_FRAMEBUFFER, outline_fbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_TEXTURE_2D, outline_depth_tex, 0);
+    }
+
+    // Copy the depth out first: sampling a texture still attached to the framebuffer being drawn is undefined.
+    glDisable(GL_SCISSOR_TEST);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, fb.fbo);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, outline_fbo);
+    glBlitFramebuffer(0, 0, fb.width, fb.height, 0, 0, fb.width, fb.height, GL_DEPTH_BUFFER_BIT, GL_NEAREST);
+    glBindFramebuffer(GL_FRAMEBUFFER, fb.fbo);
+
+    glViewport(0, 0, fb.width, fb.height);
+    glDisable(GL_DEPTH_TEST);
+    glDepthMask(GL_FALSE);
+    glEnable(GL_BLEND);
+    glStencilFunc(GL_EQUAL, 1, 0xFF);
+    glStencilOp(GL_KEEP, GL_KEEP, GL_KEEP);
+
+    // Keep the lines about the same width on screen at any internal resolution (thickness is per 480 rows).
+    float px = max(1.0f, outline_thickness * (float)fb.height / 480.0f);
+    glUseProgram(outline_program);
+    glUniform1i(outline_depth_location, 7);
+    glUniform2f(outline_step_location, px / (float)fb.width, px / (float)fb.height);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+
+    glStencilOp(GL_KEEP, GL_KEEP, GL_REPLACE);
+    glStencilFunc(GL_ALWAYS, current_depth_test ? 1 : 0, 0xFF);
+    glUseProgram(prev_program);
+    glActiveTexture(prev_active_texture);
+    glViewport(prev_viewport[0], prev_viewport[1], prev_viewport[2], prev_viewport[3]);
+    prev_blend ? glEnable(GL_BLEND) : glDisable(GL_BLEND);
+    prev_depth_test ? glEnable(GL_DEPTH_TEST) : glDisable(GL_DEPTH_TEST);
+    prev_scissor ? glEnable(GL_SCISSOR_TEST) : glDisable(GL_SCISSOR_TEST);
+    glDepthMask(prev_depth_mask);
 }
 
