+    ID3D11ShaderResourceView* null_srvs[2] = { nullptr, nullptr };
+    d3d.context->PSSetShaderResources(0, 2, null_srvs);
+    d3d.context->RSSetViewports(1, &prev_viewport);
+    d3d.context->RSSetScissorRects(1, &prev_scissor);
