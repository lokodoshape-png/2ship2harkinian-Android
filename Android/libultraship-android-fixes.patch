+        fb.stencil_srv.Get() == nullptr || fb.render_target_view.Get() == nullptr) {
+        return;
+    }
+    if (d3d.outline_vs.Get() == nullptr && !gfx_d3d11_init_outlines()) {
+        d3d.outline_init_failed = true;
+        return;
+    }
+    const TextureData& tex = d3d.textures[fb.texture_id];
+
+    // Keep the lines about the same width on screen at any internal resolution (thickness is per 480 rows).
+    int px = (int)fmaxf(1.0f, roundf(d3d.outline_thickness * (float)tex.height / 480.0f));
+    int32_t cb_data[4] = { px, px, (int32_t)tex.width, (int32_t)tex.height };
+    D3D11_MAPPED_SUBRESOURCE ms;
+    ZeroMemory(&ms, sizeof(ms));
