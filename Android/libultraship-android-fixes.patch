@@ -58,6 +58,9 @@ struct ShaderProgram {
     uint8_t num_attribs;
     GLint frame_count_location;
     GLint noise_scale_location;
+    GLint brightness_location;
+    GLint saturation_location;
+    GLint cel_bands_location;
 };
 
 struct Framebuffer {
@@ -80,6 +83,16 @@ static uint32_t frame_count;
 static vector<Framebuffer> framebuffers;
 static size_t current_framebuffer;
 static float current_noise_scale;
+// Optional colour grading (2Ship "MM3D-style lighting"): scales brightness and saturation of everything the
+// game draws. Read from CVars once per frame; 1.0 leaves the image untouched.
+static float current_brightness = 1.0f;
+// The first framebuffer clear of each frame (the game's own framebuffer) also clears colour, so screen areas the
