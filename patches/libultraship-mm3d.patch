+bool GfxRenderingAPIDX11::InitOutlines() {
+    // Same detection as the OpenGL renderer: depth stored as 1 - d is proportional to 1/z, so flat surfaces vary
+    // linearly across the screen. A pixel with a clearly farther neighbour on either side (a dip in the second
+    // difference) is on the near side of a silhouette and gets painted black. The HUD (stencil 0) is skipped.
+    static const char* source = R"(
+Texture2D<float> depthTex : register(t0);
+Texture2D<uint2> stencilTex : register(t1);
+cbuffer OutlineCB : register(b2) {
+    int2 outlineStep;
+    int2 outlineSize;
+}
+float4 VSMain(uint id : SV_VertexID) : SV_Position {
+    float2 p = float2((id << 1) & 2, id & 2);
+    return float4(p * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+}
+float w(int2 p) {
+    p = clamp(p, int2(0, 0), outlineSize - 1);
+    return 1.0 - depthTex.Load(int3(p, 0));
+}
+float4 PSMain(float4 pos : SV_Position) : SV_Target {
+    int2 p = int2(pos.xy);
+    if (stencilTex.Load(int3(p, 0)).g != 1) discard;
+    float c = w(p);
+    if (c <= 0.0) discard;
+    float l = w(p - int2(outlineStep.x, 0));
+    float r = w(p + int2(outlineStep.x, 0));
+    float d = w(p - int2(0, outlineStep.y));
+    float u = w(p + int2(0, outlineStep.y));
+    float dl = w(p + int2(-outlineStep.x, -outlineStep.y));
+    float ur = w(p + int2(outlineStep.x, outlineStep.y));
+    float dr = w(p + int2(outlineStep.x, -outlineStep.y));
+    float ul = w(p + int2(-outlineStep.x, outlineStep.y));
+    float dip = max(max(2.0 * c - l - r, 2.0 * c - d - u), 0.75 * max(2.0 * c - dl - ur, 2.0 * c - dr - ul)) / c;
+    // Wide smoothstep: lines fade in and out instead of popping, which keeps diagonals from looking jagged.
+    float edge = smoothstep(0.02, 0.10, dip);
+    if (edge <= 0.0) discard;
+    return float4(0.0, 0.0, 0.0, edge * 0.9);
+}
+)";
