+    r.textures[textureId].linearFiltering = true;
+    r.textures[textureId].sampler =
+        r.GetSampler(r.filterMode == FILTER_LINEAR, VK_SAMPLER_ADDRESS_MODE_REPEAT, VK_SAMPLER_ADDRESS_MODE_REPEAT);
+    return (int)r.framebuffers.size() - 1;
