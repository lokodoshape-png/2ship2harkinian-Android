+// Descriptor bindings of the game shaders: HLSL registers t0-t5, s0-s1 and b0-b1 shifted by glslang.
+constexpr uint32_t kTextureBinding = 0;
+constexpr uint32_t kSamplerBinding = 6;
+constexpr uint32_t kUniformBinding = 8;
+
+// Outline pass, compiled with the same HLSL frontend. Same detection as the Direct3D 11 and OpenGL renderers.
+const char* sOutlineShader = R"(
+[[vk::binding(0)]] Texture2D<float> depthTex;
+[[vk::binding(1)]] Texture2D<uint> stencilTex;
+struct OutlineParams {
+    int2 outlineStep;
+    int2 outlineSize;
+};
+[[vk::push_constant]] ConstantBuffer<OutlineParams> pc;
+float4 VSMain(uint id : SV_VertexID) : SV_Position {
+    float2 p = float2((id << 1) & 2, id & 2);
+    return float4(p * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+}
+float w(int2 p) {
+    p = clamp(p, int2(0, 0), pc.outlineSize - 1);
+    return 1.0 - depthTex.Load(int3(p, 0));
+}
+float4 PSMain(float4 pos : SV_Position) : SV_Target {
+    int2 p = int2(pos.xy);
+    if (stencilTex.Load(int3(p, 0)) != 1) discard;
+    float c = w(p);
+    if (c <= 0.0) discard;
+    int2 s = pc.outlineStep;
+    float l = w(p - int2(s.x, 0));
+    float r = w(p + int2(s.x, 0));
+    float d = w(p - int2(0, s.y));
+    float u = w(p + int2(0, s.y));
+    float dl = w(p + int2(-s.x, -s.y));
+    float ur = w(p + int2(s.x, s.y));
+    float dr = w(p + int2(s.x, -s.y));
+    float ul = w(p + int2(-s.x, s.y));
+    float dip = max(max(2.0 * c - l - r, 2.0 * c - d - u), 0.75 * max(2.0 * c - dl - ur, 2.0 * c - dr - ul)) / c;
+    float edge = smoothstep(0.02, 0.10, dip);
+    if (edge <= 0.0) discard;
+    return float4(0.0, 0.0, 0.0, edge * 0.9);
+}
+)";
+
+// Reads depth values for GetPixelDepth (the game's coordinate queries, e.g. lens flare occlusion).
