+extern "C" JNIEXPORT void JNICALL Java_com_dishii_mm_MainActivity_attachController(JNIEnv* env, jobject obj) {
+    sVirtualJoystickId = SDL_JoystickAttachVirtual(SDL_JOYSTICK_TYPE_GAMECONTROLLER, 6, 18, 0);
+    if (sVirtualJoystickId == -1) {
+        SDL_Log("Could not create the touch overlay's virtual controller");
+        return;
+    }
+    sVirtualJoystick = SDL_JoystickOpen(sVirtualJoystickId);
+    if (sVirtualJoystick == nullptr) {
+        SDL_Log("Could not open the touch overlay's virtual controller");
+    }
+    sUsingTouchscreenControls = true;
+}
+
+extern "C" JNIEXPORT void JNICALL Java_com_dishii_mm_MainActivity_detachController(JNIEnv* env, jobject obj) {
+    SDL_JoystickClose(sVirtualJoystick);
+    SDL_JoystickDetachVirtual(sVirtualJoystickId);
+    sVirtualJoystick = nullptr;
+    sVirtualJoystickId = -1;
+    sUsingTouchscreenControls = false;
+}
