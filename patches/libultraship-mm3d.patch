+// Draws the cel shading outlines over a finished game frame. Runs only on a single-sample framebuffer the game
+// rendered into, and puts back every bit of GL state it touches.
+void GfxRenderingAPIOGL::DrawOutlines(int fbId) {
+    if (!mMM3D.outlines || mOutlineInitFailed || fbId <= 0 || (size_t)fbId >= mFrameBuffers.size()) {
+        return;
+    }
+    FramebufferOGL& fb = mFrameBuffers[fbId];
+    if (fb.msaa_level > 1 || !fb.has_depth_buffer) {
+        return;
+    }
+    if (mOutlineProgram == 0 && !InitOutlineProgram()) {
+        mOutlineInitFailed = true;
+        return;
+    }
+
+    GLint prevProgram, prevActiveTexture, prevViewport[4];
+    glGetIntegerv(GL_CURRENT_PROGRAM, &prevProgram);
+    glGetIntegerv(GL_ACTIVE_TEXTURE, &prevActiveTexture);
+    glGetIntegerv(GL_VIEWPORT, prevViewport);
+    GLboolean prevBlend = glIsEnabled(GL_BLEND);
+    GLboolean prevDepthTest = glIsEnabled(GL_DEPTH_TEST);
+    GLboolean prevScissor = glIsEnabled(GL_SCISSOR_TEST);
+    GLboolean prevDepthMask;
+    glGetBooleanv(GL_DEPTH_WRITEMASK, &prevDepthMask);
+
+    glActiveTexture(GL_TEXTURE0 + 7);
+    glBindTexture(GL_TEXTURE_2D, mOutlineDepthTex);
+    if (mOutlineWidth != fb.width || mOutlineHeight != fb.height) {
+        mOutlineWidth = fb.width;
+        mOutlineHeight = fb.height;
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH24_STENCIL8, fb.width, fb.height, 0, GL_DEPTH_STENCIL,
+                     GL_UNSIGNED_INT_24_8, NULL);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glBindFramebuffer(GL_FRAMEBUFFER, mOutlineFbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_TEXTURE_2D, mOutlineDepthTex, 0);
+    }
+
+    // Copy the depth out first: sampling a texture still attached to the framebuffer being drawn is undefined.
+    glDisable(GL_SCISSOR_TEST);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, fb.fbo);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, mOutlineFbo);
+    glBlitFramebuffer(0, 0, fb.width, fb.height, 0, 0, fb.width, fb.height, GL_DEPTH_BUFFER_BIT, GL_NEAREST);
+    glBindFramebuffer(GL_FRAMEBUFFER, fb.fbo);
+
+    glViewport(0, 0, fb.width, fb.height);
+    glDisable(GL_DEPTH_TEST);
+    glDepthMask(GL_FALSE);
+    glEnable(GL_BLEND);
+    glEnable(GL_STENCIL_TEST);
+    glStencilFunc(GL_EQUAL, 1, 0xFF);
+    glStencilOp(GL_KEEP, GL_KEEP, GL_KEEP);
+
+    // Keep the lines about the same width on screen at any internal resolution (thickness is per 480 rows).
+    float px = std::max(1.0f, mMM3D.outlineThickness * (float)fb.height / 480.0f);
+    glUseProgram(mOutlineProgram);
+    glUniform1i(mOutlineDepthLocation, 7);
+    glUniform2f(mOutlineStepLocation, px / (float)fb.width, px / (float)fb.height);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+
+    glStencilOp(GL_KEEP, GL_KEEP, GL_REPLACE);
+    glStencilFunc(GL_ALWAYS, mCurrentDepthTest ? 1 : 0, 0xFF);
+    glUseProgram(prevProgram);
+    glActiveTexture(prevActiveTexture);
+    glViewport(prevViewport[0], prevViewport[1], prevViewport[2], prevViewport[3]);
+    prevBlend ? glEnable(GL_BLEND) : glDisable(GL_BLEND);
+    prevDepthTest ? glEnable(GL_DEPTH_TEST) : glDisable(GL_DEPTH_TEST);
+    prevScissor ? glEnable(GL_SCISSOR_TEST) : glDisable(GL_SCISSOR_TEST);
+    glDepthMask(prevDepthMask);
+    mCurrentFrameBuffer = fbId;
