+void GfxRenderingAPIVulkan::UploadTexture(const uint8_t* rgba32Buf, uint32_t width, uint32_t height) {
+    VulkanRenderer& r = *mImpl;
+    TextureVK& tex = r.textures[r.currentTextureIds[r.currentTile]];
+    width = std::max(width, 1u);
+    height = std::max(height, 1u);
+    VkCommandBuffer cmd = r.UploadCmd();
+    FrameSlot& f = r.frames[r.frameIndex];
+    VkDeviceSize bytes = (VkDeviceSize)width * height * 4;
+    VkDeviceSize offset = r.HostAlloc(f.staging, bytes, 16, VK_BUFFER_USAGE_TRANSFER_SRC_BIT);
+    memcpy(f.staging.data + offset, rgba32Buf, bytes);
+
+    // Always a new image: draws already recorded this frame keep using the old one.
+    auto img = r.CreateImage(width, height, kColorFormat,
+                             VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+                                 VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+                             VK_SAMPLE_COUNT_1_BIT, false);
+    r.Transition(cmd, *img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    VkBufferImageCopy region = {};
+    region.bufferOffset = offset;
+    region.imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+    region.imageExtent = { width, height, 1 };
+    vkCmdCopyBufferToImage(cmd, f.staging.buffer, img->image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+    r.Transition(cmd, *img, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+    tex.image = img;
+    tex.width = width;
+    tex.height = height;
+}
