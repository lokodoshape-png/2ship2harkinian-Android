+bool GfxRenderingAPIOGL::InitOutlineProgram() {
+#if defined(__APPLE__)
+#define OUTLINE_GLSL_HEADER "#version 410 core\n"
+#elif defined(USE_OPENGLES)
+#define OUTLINE_GLSL_HEADER "#version 300 es\nprecision highp float;\nprecision highp sampler2D;\n"
+#else
+#define OUTLINE_GLSL_HEADER "#version 130\n"
+#endif
+    static const char* vsSrc = OUTLINE_GLSL_HEADER "out vec2 uv;\n"
+                                                   "void main() {\n"
+                                                   "    vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));\n"
+                                                   "    uv = p;\n"
+                                                   "    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);\n"
+                                                   "}\n";
+    // Depth is stored as 1 - d, which is proportional to 1/z, so flat surfaces vary linearly across the screen.
+    // A pixel whose neighbour on either side is clearly farther (a dip in the second difference) sits on the near
+    // side of a silhouette and gets painted black. Floors seen at a low angle stay clean because they are flat.
+    static const char* fsSrc = OUTLINE_GLSL_HEADER "in vec2 uv;\n"
+                                                   "out vec4 fragColor;\n"
+                                                   "uniform sampler2D uDepth;\n"
+                                                   "uniform vec2 uStep;\n"
+                                                   "float w(vec2 o) { return 1.0 - texture(uDepth, uv + o).r; }\n"
+                                                   "void main() {\n"
+                                                   "    float c = w(vec2(0.0));\n"
+                                                   "    if (c <= 0.0) discard;\n"
+                                                   "    float l = w(vec2(-uStep.x, 0.0));\n"
+                                                   "    float r = w(vec2(uStep.x, 0.0));\n"
+                                                   "    float d = w(vec2(0.0, -uStep.y));\n"
+                                                   "    float u = w(vec2(0.0, uStep.y));\n"
+                                                   "    float dl = w(-uStep);\n"
+                                                   "    float ur = w(uStep);\n"
+                                                   "    float dr = w(vec2(uStep.x, -uStep.y));\n"
+                                                   "    float ul = w(vec2(-uStep.x, uStep.y));\n"
+                                                   "    float dip = max(max(2.0 * c - l - r, 2.0 * c - d - u), 0.75 * "
+                                                   "max(2.0 * c - dl - ur, 2.0 * c - dr - ul)) / c;\n"
+                                                   "    float edge = smoothstep(0.02, 0.10, dip);\n"
+                                                   "    if (edge <= 0.0) discard;\n"
+                                                   "    fragColor = vec4(0.0, 0.0, 0.0, edge * 0.9);\n"
+                                                   "}\n";
+#undef OUTLINE_GLSL_HEADER
+
+    GLuint vs = CompileOutlineShader(GL_VERTEX_SHADER, vsSrc);
+    GLuint fs = CompileOutlineShader(GL_FRAGMENT_SHADER, fsSrc);
+    if (vs == 0 || fs == 0) {
+        return false;
+    }
+    mOutlineProgram = glCreateProgram();
+    glAttachShader(mOutlineProgram, vs);
+    glAttachShader(mOutlineProgram, fs);
+    glLinkProgram(mOutlineProgram);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    GLint linked;
+    glGetProgramiv(mOutlineProgram, GL_LINK_STATUS, &linked);
+    if (!linked) {
+        SPDLOG_ERROR("Outline shader link failed");
+        glDeleteProgram(mOutlineProgram);
+        mOutlineProgram = 0;
+        return false;
+    }
+    mOutlineDepthLocation = glGetUniformLocation(mOutlineProgram, "uDepth");
+    mOutlineStepLocation = glGetUniformLocation(mOutlineProgram, "uStep");
+    glGenFramebuffers(1, &mOutlineFbo);
+    glGenTextures(1, &mOutlineDepthTex);
+    return true;
+}
