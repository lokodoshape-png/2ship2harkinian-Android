+struct PipelineKey {
+    ShaderProgramVK* program;
+    VkRenderPass renderPass;
+    uint32_t flags;
+    bool operator==(const PipelineKey& o) const {
+        return program == o.program && renderPass == o.renderPass && flags == o.flags;
+    }
+};
+
+struct PipelineKeyHash {
+    size_t operator()(const PipelineKey& k) const {
+        return std::hash<void*>()(k.program) ^ (std::hash<void*>()(k.renderPass) << 1) ^ (k.flags * 0x9E3779B9u);
+    }
+};
