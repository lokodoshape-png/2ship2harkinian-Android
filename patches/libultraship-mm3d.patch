+    ZeroMemory(&ms, sizeof(ms));
+    mContext->Map(mOutlineCb.Get(), 0, D3D11_MAP_WRITE_DISCARD, 0, &ms);
+    memcpy(ms.pData, cbData, sizeof(cbData));
+    mContext->Unmap(mOutlineCb.Get(), 0);
+
+    UINT numViewports = 1, numScissors = 1;
+    D3D11_VIEWPORT prevViewport;
+    D3D11_RECT prevScissor;
+    mContext->RSGetViewports(&numViewports, &prevViewport);
+    mContext->RSGetScissorRects(&numScissors, &prevScissor);
+
+    // The depth buffer is read as a texture, so it can't stay bound for writing during the pass.
+    mContext->OMSetRenderTargets(1, fb.render_target_view.GetAddressOf(), nullptr);
+    D3D11_VIEWPORT viewport = { 0.0f, 0.0f, (float)tex.width, (float)tex.height, 0.0f, 1.0f };
+    D3D11_RECT scissor = { 0, 0, (LONG)tex.width, (LONG)tex.height };
+    mContext->RSSetViewports(1, &viewport);
+    mContext->RSSetScissorRects(1, &scissor);
+
+    mContext->IASetInputLayout(nullptr);
+    mContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    mContext->VSSetShader(mOutlineVs.Get(), nullptr, 0);
+    mContext->PSSetShader(mOutlinePs.Get(), nullptr, 0);
+    mContext->PSSetConstantBuffers(2, 1, mOutlineCb.GetAddressOf());
+    ID3D11ShaderResourceView* srvs[2] = { fb.depth_stencil_srv.Get(), fb.stencil_srv.Get() };
+    mContext->PSSetShaderResources(0, 2, srvs);
+    mContext->OMSetBlendState(mOutlineBlendState.Get(), nullptr, 0xFFFFFFFF);
+    mContext->Draw(3, 0);
+
+    ID3D11ShaderResourceView* nullSrvs[2] = { nullptr, nullptr };
+    mContext->PSSetShaderResources(0, 2, nullSrvs);
+    mContext->RSSetViewports(1, &prevViewport);
+    mContext->RSSetScissorRects(1, &prevScissor);
