+
+static void CallActivityVoidMethod(const char* name) {
+    JNIEnv* env = (JNIEnv*)SDL_AndroidGetJNIEnv();
+    jobject activity = (jobject)SDL_AndroidGetActivity();
+    if (env == nullptr || activity == nullptr) {
+        return;
+    }
+    jclass activityClass = env->GetObjectClass(activity);
+    jmethodID method = env->GetMethodID(activityClass, name, "()V");
+    if (method != nullptr) {
+        env->CallVoidMethod(activity, method);
+    } else {
+        env->ExceptionClear();
+    }
+    env->DeleteLocalRef(activityClass);
+    env->DeleteLocalRef(activity);
+}
+
+// While a menu is open, swipes on the camera area go to ImGui instead of turning the camera.
+void Ship::Mobile::EnableTouchArea() {
+    CallActivityVoidMethod("EnableTouchArea");
+}
+
+void Ship::Mobile::DisableTouchArea() {
+    CallActivityVoidMethod("DisableTouchArea");
+}
+
+float Ship::Mobile::GetCameraYaw() {
