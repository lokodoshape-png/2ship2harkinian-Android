+void GfxRenderingAPIVulkan::StartFrame() {
+    VulkanRenderer& r = *mImpl;
+    r.perFrameData.noise_frame++;
+    if (r.perFrameData.noise_frame > 150) {
+        // No high values, as noise starts to look ugly
+        r.perFrameData.noise_frame = 0;
+    }
+    MM3DRenderSettings mm3d = GetMM3DRenderSettings();
+    r.perFrameData.color_brightness = mm3d.brightness;
+    r.perFrameData.color_saturation = mm3d.saturation;
+    r.perFrameData.color_cel_bands = mm3d.celBands;
+    r.outlineEnabled = mm3d.outlines && r.depthSampleable;
+    r.outlineThickness = mm3d.outlineThickness;
+    r.perFrameDirty = true;
+    r.StartFrame();
+}
