+// Draws the cel shading outlines over a finished game frame (single-sample framebuffer with a readable depth
+// buffer). Pipeline state it changes is either restored or marked dirty so the next draw sets it again.
+void GfxRenderingAPIDX11::DrawOutlines(int fbId) {
+    if (!mOutlineEnabled || mOutlineInitFailed || fbId <= 0 || (size_t)fbId >= mFrameBuffers.size()) {
+        return;
+    }
+    FramebufferDX11& fb = mFrameBuffers[fbId];
+    if (fb.msaa_level > 1 || !fb.has_depth_buffer || fb.depth_stencil_srv.Get() == nullptr ||
+        fb.stencil_srv.Get() == nullptr || fb.render_target_view.Get() == nullptr) {
+        return;
+    }
+    if (mOutlineVs.Get() == nullptr && !InitOutlines()) {
+        mOutlineInitFailed = true;
+        return;
+    }
+    const TextureData& tex = mTextures[fb.texture_id];
+
+    // Keep the lines about the same width on screen at any internal resolution (thickness is per 480 rows).
