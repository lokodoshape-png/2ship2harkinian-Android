+#pragma once
+
+#if defined(ENABLE_DX11) || defined(ENABLE_DX12) || defined(ENABLE_VULKAN)
+
+#ifdef __cplusplus
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include "fast/interpreter.h"
+
+namespace Fast {
+
+// Constant buffer layouts of shaders/directx/default.shader.hlsl (register b0 and b1).
+struct PerFrameCB {
+    uint32_t noise_frame;
+    float noise_scale;
+    float color_brightness;
+    float color_saturation;
+    float color_cel_bands;
+    uint32_t padding[3]; // constant buffers must be multiples of 16 bytes in size
+};
+
+struct PerDrawCB {
+    struct Texture {
+        uint32_t width;
+        uint32_t height;
+        uint32_t linear_filtering;
+        uint32_t padding;
+    } mTextures[SHADER_MAX_TEXTURES];
+};
+
+struct Coord {
+    int x, y;
+};
+
+// Builds the HLSL source for a color combiner from the default shader template. numFloats receives the vertex size.
+std::string gfx_hlsl_build_shader(size_t& numFloats, const CCFeatures& cc_features, bool include_root_signature,
+                                  bool three_point_filtering, bool use_srgb);
+
+} // namespace Fast
+#endif
+#endif
