+#version 450
+layout(local_size_x = 1) in;
+layout(binding = 0) uniform sampler2D depthTex;
+layout(std430, binding = 1) readonly buffer Coords { ivec2 coords[]; };
+layout(std430, binding = 2) writeonly buffer Depths { float depths[]; };
+void main() {
+    uint i = gl_GlobalInvocationID.x;
+    depths[i] = texelFetch(depthTex, coords[i], 0).r;
+}
+)";
+
+const char* sDepthReadShaderMsaa = R"(
+#version 450
+layout(local_size_x = 1) in;
+layout(binding = 0) uniform sampler2DMS depthTex;
+layout(std430, binding = 1) readonly buffer Coords { ivec2 coords[]; };
+layout(std430, binding = 2) writeonly buffer Depths { float depths[]; };
+void main() {
+    uint i = gl_GlobalInvocationID.x;
+    depths[i] = texelFetch(depthTex, coords[i], 0).r;
+}
+)";
